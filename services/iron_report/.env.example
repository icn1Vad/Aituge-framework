IRON_REPORT_INTERNAL_TOKEN=replace-with-at-least-16-random-characters
IRON_REPORT_MODEL_ID=replace-with-configured-model-id
IRON_REPORT_MODEL_NAME=replace-with-provider-model-name
IRON_REPORT_MODEL_BASE_URL=replace-with-openai-compatible-base-url
IRON_REPORT_MODEL_API_KEY=replace-with-model-key
IRON_REPORT_MODEL_PROVIDER=openai_like
IRON_REPORT_MODEL_CONTEXT_WINDOW=64000
IRON_REPORT_MODEL_MAX_TOKENS=8000
IRON_REPORT_SEARCH_ENDPOINT=replace-with-search-endpoint-or-leave-empty
IRON_REPORT_SEARCH_API_KEY=replace-with-search-key-or-leave-empty
IRON_REPORT_SEARCH_COUNT=8
IRON_REPORT_SERVICE_BASE_URL=http://127.0.0.1:18300
IRON_REPORT_DATA_ROOT=/app/services/iron_report/demo_data
IRON_REPORT_RUNTIME_ROOT=/app/runtime/iron-report
IRON_REPORT_LIBREOFFICE_PATH=/usr/bin/libreoffice
IRON_REPORT_LIBREOFFICE_TIMEOUT_SECONDS=90
IRON_REPORT_MAX_ARTIFACT_BYTES=31457280

# Framework model/search endpoints and keys are imported from a private runtime
# configuration or injected by the isolated deployment. Do not add them here.
