PROOF_DATABASE_URL=postgresql://proof_user:change-me@127.0.0.1:15432/proofreading
PROOF_STORAGE_ROOT=.proof-data
PROOF_DATASET_ROOT=/home/ningrx25/data/aituge-appliance/数据集
PROOF_MAX_UPLOAD_BYTES=26214400

# Alibaba Cloud Model Studio OpenAI-compatible embedding example.
# Workspace keys should use the workspace-specific base URL documented by Alibaba Cloud.
PROOF_EMBEDDING_BASE_URL=
PROOF_EMBEDDING_API_KEY=
PROOF_EMBEDDING_MODEL=text-embedding-v4
PROOF_EMBEDDING_DIMENSIONS=1024
# Optional provider limit. Over-limit clauses remain whole and are marked embedding_too_long.
PROOF_EMBEDDING_MAX_INPUT_CHARS=
PROOF_EMBEDDING_TIMEOUT_SECONDS=30

# Hybrid policy retrieval. Reranking reuses PROOF_EMBEDDING_API_KEY when its
# own key is empty.
PROOF_RETRIEVAL_KEYWORD_LIMIT=30
PROOF_RETRIEVAL_VECTOR_LIMIT=30
PROOF_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
PROOF_RERANK_API_KEY=
PROOF_RERANK_MODEL=qwen3-rerank
PROOF_RERANK_TIMEOUT_SECONDS=30
PROOF_RERANK_CANDIDATE_LIMIT=30

# Agent-generated read-only SQL execution limits.
PROOF_SQL_STATEMENT_TIMEOUT_SECONDS=5
PROOF_SQL_MAX_ROWS=100
PROOF_SQL_MAX_RESPONSE_CHARS=50000

# Framework-backed policy review pipeline.
PROOF_SEMANTIC_AUDIT_ENABLED=false
PROOF_FRAMEWORK_BASE_URL=
PROOF_FRAMEWORK_USER_ID=proof-service
PROOF_FRAMEWORK_TENANT_ID=__default_tenant_id__
PROOF_AUDIT_MODEL_ID=deepseek-v4-pro
PROOF_CONFLICT_MODEL_ID=deepseek-v4-pro
PROOF_AUDIT_BATCH_MAX_CHARS=6000
PROOF_AUDIT_BATCH_MAX_CHUNKS=8
PROOF_AUDIT_MAX_CHUNK_CHARS=12000
PROOF_AUDIT_MAX_CONCURRENCY=4
PROOF_SUMMARY_MAX_CHARS=60000
