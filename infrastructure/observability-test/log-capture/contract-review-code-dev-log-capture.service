[Unit]
Description=Contract review test-only redacted Docker log capture
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=aituge
Group=aituge
SupplementaryGroups=docker
# Install this regular unit as root:root mode 0644. The executable release is
# root:root and immutable; no mutable EnvironmentFile is permitted.
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="CONTRACT_REVIEW_DEV_CAPTURE_MODE=PROJECT_DISCOVERY"
Environment="CONTRACT_REVIEW_DEV_CAPTURE_TEST_NETWORKS=ollama-isolated-net"
Environment="CONTRACT_REVIEW_DEV_CAPTURE_SELECTOR_FILE=/home/aituge/contract-review-code-dev-test-private/observability-capture.selectors"
Environment="CONTRACT_REVIEW_DEV_OBSERVABILITY_LOG_ROOT=/home/aituge/contract-review-code-dev-test-private/observability-logs/redacted"
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
ExecStart=/usr/bin/bash /opt/contract-review-code-dev-observability/releases/observability-page8-v1.5.2/infrastructure/observability-test/log-capture/capture-test-container-logs.sh
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/contract-review-code-dev-observability/releases/observability-page8-v1.5.2
ReadWritePaths=/home/aituge/contract-review-code-dev-test-private/observability-logs/redacted
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
